# Environment Variables for QuantChain Examples
# Copy this file to .env and fill in your actual API keys
# DO NOT commit the .env file to version control!

# ======== TRADING API KEYS ========
# Required for Memecoin Vibe Trader and Chart Reader Agent
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading endpoint

# ======== LLM PROVIDER API KEYS ========
# Choose at least one LLM provider for AI analysis

# OpenAI (recommended for vision capabilities)
OPENAI_API_KEY=your_openai_key_here
# Set in config: provider: openai, model: gpt-4 or gpt-4-vision-preview

# Anthropic Claude (good for code analysis)
ANTHROPIC_API_KEY=your_anthropic_key_here
# Set in config: provider: anthropic, model: claude-3-opus-20240229

# Ollama (local models, no API key required)
# Set in config: provider: ollama, model: llama2:7b
# Make sure Ollama is running locally on port 11434

# ======== BLOCKCHAIN EXPLORER API KEYS ========
# Required for Smart Contract Auditor
# Get from the respective explorer websites (usually free)

ETHERSCAN_API_KEY=your_etherscan_key_here  # https://etherscan.io/apis
BSCSCAN_API_KEY=your_bscscan_key_here      # https://bscscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_key  # https://polygonscan.com/apis
ARBISCAN_API_KEY=your_arbiscan_key_here    # https://arbiscan.io/apis
OPTIMISM_API_KEY=your_optimism_key_here    # https://optimistic.etherscan.io/apis

# ======== SOCIAL MEDIA API KEYS ========
# Optional for Memecoin Vibe Trader (enhanced sentiment analysis)

# Twitter/X API
TWITTER_API_KEY=your_twitter_key_here
TWITTER_API_SECRET=your_twitter_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
# Get from: https://developer.twitter.com/

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_token_here
# Create bot at: https://t.me/BotFather

# ======== DATA PROVIDER API KEYS ========
# Optional alternatives to Alpaca

# Alpha Vantage (free tier available)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# Get from: https://www.alphavantage.co/support/#api-key

# Polygon.io (crypto data)
POLYGON_API_KEY=your_polygon_io_key_here
# Get from: https://polygon.io/

# ======== CONFIGURATION NOTES ========

# 1. API Key Registration:
#    - Most services offer free tiers for development
#    - Some require email verification
#    - Keep your keys private and never share them

# 2. Required vs Optional:
#    - Required: ALPACA_API_KEYS + at least one LLM provider
#    - For contract auditing: at least one blockchain explorer API key
#    - Optional: Social media and alternative data provider keys

# 3. Security Best Practices:
#    - NEVER commit .env to version control
#    - Use different keys for development and production
#    - Rotate keys periodically
#    - Monitor API usage for unusual activity

# 4. Quick Setup:
#    a) Copy this file: cp examples/.env.example .env
#    b) Edit .env with your API keys
#    c) Install dependencies: pip install -r requirements.txt
#    d) Run example: python examples/memecoin_vibe_trader_example.py

# 5. Paper Trading Safety:
#    - All examples default to paper trading mode
#    - No real money is at risk with default settings
#    - Change `paper_trading: false` in config ONLY when ready for real trading
