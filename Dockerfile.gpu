# GPU-enabled Dockerfile for QuantChain with NVIDIA CUDA support
# Requires NVIDIA Docker runtime and nvidia-container-toolkit

FROM nvidia/cuda:12.1-runtime-ubuntu22.04

# Set non-interactive frontend for package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies including CUDA libraries
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    build-essential \
    curl \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Verify CUDA installation
RUN python3 -c "import subprocess; subprocess.run(['nvidia-smi'])" || echo "NVIDIA GPU not available"

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .
COPY requirements-dev.txt .

# Upgrade pip and install Python dependencies
RUN python3 -m pip install --upgrade pip setuptools wheel

# Install CUDA-compatible versions of key ML libraries
RUN python3 -m pip install --no-cache-dir \
    torch==2.1.0+cu121 \
    torchvision==0.16.0+cu121 \
    torchaudio==2.1.0+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Install project dependencies
RUN python3 -m pip install --no-cache-dir -r requirements.txt

# Install development dependencies (optional)
RUN python3 -m pip install --no-cache-dir -r requirements-dev.txt

# Install quantchain in development mode
COPY . .
RUN python3 -m pip install -e .

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash quantchain \
    && usermod -aG sudo quantchain

# Set ownership
RUN chown -R quantchain:quantchain /app

# Switch to non-root user
USER quantchain

# Add local Python to PATH
ENV PATH=/home/quantchain/.local/bin:$PATH
ENV PYTHONPATH=/app:$PYTHONPATH
ENV CUDA_VISIBLE_DEVICES=all

# Expose ports
EXPOSE 8501 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD python3 -c "import quantchain; print('QuantChain GPU container healthy')" || exit 1

# Default command for GPU-enabled operation
CMD ["python3", "-c", "import torch; print(f'CUDA available: {torch.cuda.is_available()}'); print(f'GPU count: {torch.cuda.device_count()}'); import quantchain; print('QuantChain GPU ready!')"]
